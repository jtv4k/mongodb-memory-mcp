# dependencies
node_modules/
.npm-cache/
.npm/

# Container HOME. scripts/ndocker.sh points HOME/XDG/TMPDIR here instead of /tmp
# or the caller's home so containerised tooling never writes outside the project.
.container-home/

# build output
dist/
*.tsbuildinfo

# generated assets (built by tailwindcss)
src/public/css/app.css

# secrets — real env files are NEVER committed
.env
.env.*
!.env.example

# Atlas Local bind mounts (docker/atlas-local/) — mongod WiredTiger files, mongot
# search index data, and the generated mongod<->mongot keyfile. The keyfile is a
# secret; the data dirs are local state. See docker/atlas-local/README.md.
docker/atlas-local/mongod/data/*
!docker/atlas-local/mongod/data/.gitkeep
docker/atlas-local/mongot/data/*
!docker/atlas-local/mongot/data/.gitkeep
docker/atlas-local/mongod/conf/keyfile

# test / tooling output
coverage/
.vitest/
*.log
npm-debug.log*

# Per-developer Claude Code state: local settings (tool permissions etc.),
# scratch worktrees, local workflow scripts and personal operating notes. The
# shared skills under .claude/skills/ ARE committed; these are not.
.claude/settings.local.json
.claude/worktrees/
.claude/workflows/
CLAUDE.local.md

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
