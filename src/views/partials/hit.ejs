<%#
  One search result.

  Locals: hit (a HitView from http/web.ts), maxScore.

  SECURITY — read before editing.

  `hit.fragmentsHtml` is the ONLY value on this page printed with the raw
  output tag, and it is markup on purpose: it carries the mark elements
  wrapped around the matched query terms.
  It is produced exclusively by `renderFragmentsHtml` in services/highlight.ts,
  which HTML-escapes every character of the chunk and then writes the tags
  itself, so nothing from an ingested document can become an element here.

  Do not build highlight markup in this template, do not concatenate anything
  into that string, and do not switch any other value below to the raw tag.
  Titles, sourceIds, headings, tags and URIs are all ingested content and stay
  on the escaping tag.
-%>
<article
  class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 sm:p-5 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-700"
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class="text-base font-semibold text-slate-900 dark:text-slate-50">
        <span class="mr-1 text-xs font-normal text-slate-400 tabular-nums dark:text-slate-500"
          ><%= hit.rank %>.</span
        >
        <a
          href="<%= hit.documentHref %>"
          class="rounded-sm underline decoration-slate-300 underline-offset-2 hover:decoration-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:decoration-slate-600"
          ><%= hit.title %></a
        >
      </h3>

      <% if (hit.headingPath.length > 0) { %>
      <nav aria-label="Heading path" class="mt-1 text-xs text-slate-600 dark:text-slate-400">
        <% hit.headingPath.forEach(function (heading, index) { %><% if (index > 0) { %>
        <span aria-hidden="true" class="px-1 text-slate-400">›</span>
        <% } %><span><%= heading %></span><% }); %>
      </nav>
      <% } %>
    </div>

    <div class="shrink-0 text-right">
      <p class="font-mono text-sm text-slate-800 tabular-nums dark:text-slate-200">
        <%= hit.scoreLabel %>
      </p>
      <meter
        class="mt-0.5 h-1.5 w-24"
        min="0"
        max="<%= maxScore %>"
        value="<%= hit.score %>"
        aria-label="Relevance score <%= hit.scoreLabel %>"
      ></meter>
      <p class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400"><%= hit.foundByLabel %></p>
    </div>
  </div>

  <div class="mt-3 space-y-2 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
    <% hit.fragmentsHtml.forEach(function (fragment) { %>
    <p class="[&_mark]:rounded-sm [&_mark]:bg-amber-200 [&_mark]:px-0.5 [&_mark]:text-slate-900">
      <%- fragment %>
    </p>
    <% }); %>
  </div>

  <dl
    class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-slate-100 pt-3 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400"
  >
    <div class="flex items-center gap-1">
      <dt class="sr-only">Source</dt>
      <dd class="font-mono break-all text-slate-700 dark:text-slate-300"><%= hit.sourceId %></dd>
    </div>
    <div class="flex items-center gap-1">
      <dt>chunk</dt>
      <dd class="tabular-nums">#<%= hit.chunkIndex %></dd>
    </div>
    <div class="flex items-center gap-1">
      <dt class="sr-only">Content type</dt>
      <dd><%= hit.contentType %></dd>
    </div>
    <% if (hit.uriHref) { %>
    <div class="flex min-w-0 items-center gap-1">
      <dt class="sr-only">Origin</dt>
      <dd class="min-w-0">
        <a
          href="<%= hit.uriHref %>"
          rel="noreferrer noopener nofollow external"
          class="block truncate underline underline-offset-2 hover:text-indigo-700 dark:hover:text-indigo-300"
          ><%= hit.uri %></a
        >
      </dd>
    </div>
    <% } else if (hit.uri) { %>
    <div class="flex min-w-0 items-center gap-1">
      <dt class="sr-only">Origin</dt>
      <%# Not an http(s) URL — a file path or ticket ref. Shown, never linked. -%>
      <dd class="truncate font-mono"><%= hit.uri %></dd>
    </div>
    <% } %>
    <% if (hit.tags.length > 0) { %>
    <div class="flex flex-wrap items-center gap-1">
      <dt class="sr-only">Tags</dt>
      <% hit.tags.forEach(function (tag) { %>
      <dd
        class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-700 dark:bg-slate-800 dark:text-slate-300"
      >
        <%= tag %>
      </dd>
      <% }); %>
    </div>
    <% } %>
  </dl>
</article>
