<%#
  Site header and primary navigation.

  Reads only `appName` and `activeNav`, both app-level locals, so it renders
  identically from a page route and from the error handler (which can fire for a
  request that never reached the web router).
-%>
<header
  class="border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90"
>
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:px-6 lg:px-10"
  >
    <a
      href="/search"
      class="group flex items-baseline gap-2 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-600"
    >
      <span class="text-base font-semibold tracking-tight text-slate-900 dark:text-slate-50">
        <%= appName %>
      </span>
      <span class="text-xs font-medium text-slate-500 dark:text-slate-400">knowledge base</span>
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-1 text-sm font-medium">
        <li>
          <a
            href="/search"
            <% if (activeNav === 'search') { %>aria-current="page"<% } %>
            class="<%= activeNav === 'search'
              ? 'block rounded-md bg-slate-900 px-3 py-1.5 text-white dark:bg-slate-100 dark:text-slate-900'
              : 'block rounded-md px-3 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white' %> focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            >Search</a
          >
        </li>
        <li>
          <a
            href="/documents"
            <% if (activeNav === 'documents') { %>aria-current="page"<% } %>
            class="<%= activeNav === 'documents'
              ? 'block rounded-md bg-slate-900 px-3 py-1.5 text-white dark:bg-slate-100 dark:text-slate-900'
              : 'block rounded-md px-3 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white' %> focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            >Documents</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>
