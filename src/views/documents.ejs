<%#
  Browse every ingested document.

  Locals: form { q, tag }, documents (DocumentRow view models), pagination.

  All values are ingested content and go through the escaping output tag.
  The raw output tag does not appear on this page at all.
-%>
<h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-50">Documents</h1>
<p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
  Everything in the knowledge base, newest first. Open a document to see its chunks and the
  embedding model each one was written with.
</p>

<form
  action="/documents"
  method="get"
  class="mt-6 grid gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[2fr_1fr_auto] sm:items-end sm:p-5 dark:border-slate-800 dark:bg-slate-900"
>
  <div>
    <label for="q" class="block text-sm font-medium text-slate-800 dark:text-slate-200">
      Title, source or URI contains
    </label>
    <input
      id="q"
      name="q"
      type="search"
      autocomplete="off"
      value="<%= form.q %>"
      placeholder="runbook"
      class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus-visible:border-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-indigo-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500"
    />
  </div>
  <div>
    <label for="tag" class="block text-sm font-medium text-slate-800 dark:text-slate-200">
      Tag
    </label>
    <input
      id="tag"
      name="tag"
      type="text"
      value="<%= form.tag %>"
      placeholder="aggregation"
      class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus-visible:border-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-indigo-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500"
    />
  </div>
  <button
    type="submit"
    class="h-[42px] rounded-lg bg-slate-900 px-5 font-medium text-white hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-white"
  >
    Filter
  </button>
</form>

<% if (documents.length === 0) { %>
<div
  class="mt-8 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center dark:border-slate-700 dark:bg-slate-900"
>
  <p class="text-sm font-medium text-slate-800 dark:text-slate-200">No documents match.</p>
  <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
    Content arrives through the <code class="font-mono">store_content</code> MCP tool or
    <code class="font-mono">POST /api/content</code>. Nothing has been ingested that matches these
    filters yet.
  </p>
</div>
<% } else { %>

<p class="mt-6 text-xs text-slate-500 dark:text-slate-400">
  Showing <%= pagination.from %>–<%= pagination.to %> of <%= pagination.totalLabel %>
</p>

<ul class="mt-2 space-y-3">
  <% documents.forEach(function (doc) { %>
  <li
    class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-slate-300 sm:p-5 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-700"
  >
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 class="min-w-0 text-base font-semibold text-slate-900 dark:text-slate-50">
        <a
          href="<%= doc.href %>"
          class="rounded-sm underline decoration-slate-300 underline-offset-2 hover:decoration-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:decoration-slate-600"
          ><%= doc.title %></a
        >
      </h2>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        updated <%= doc.updatedLabel %> · v<%= doc.version %>
      </p>
    </div>

    <p class="mt-1 font-mono text-xs break-all text-slate-600 dark:text-slate-400">
      <%= doc.sourceId %>
    </p>

    <% if (doc.excerpt) { %>
    <p class="mt-2 line-clamp-2 text-sm text-slate-700 dark:text-slate-300"><%= doc.excerpt %></p>
    <% } %>

    <div
      class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-slate-100 pt-3 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400"
    >
      <span><%= doc.contentType %></span>
      <span><%= doc.chunkLabel %></span>
      <span><%= doc.sizeLabel %></span>
      <% if (doc.uriHref) { %>
      <a
        href="<%= doc.uriHref %>"
        rel="noreferrer noopener nofollow external"
        class="max-w-xs truncate underline underline-offset-2 hover:text-indigo-700 dark:hover:text-indigo-300"
        ><%= doc.uri %></a
      >
      <% } else if (doc.uri) { %>
      <span class="max-w-xs truncate font-mono"><%= doc.uri %></span>
      <% } %>
      <% if (doc.tags.length > 0) { %>
      <span class="flex flex-wrap items-center gap-1">
        <% doc.tags.forEach(function (tag) { %>
        <span
          class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-700 dark:bg-slate-800 dark:text-slate-300"
          ><%= tag %></span
        >
        <% }); %>
      </span>
      <% } %>
    </div>
  </li>
  <% }); %>
</ul>

<nav
  aria-label="Pagination"
  class="mt-6 flex items-center justify-between gap-4 border-t border-slate-200 pt-4 dark:border-slate-800"
>
  <% if (pagination.prevHref) { %>
  <a
    href="<%= pagination.prevHref %>"
    rel="prev"
    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
    >← Previous</a
  >
  <% } else { %>
  <span
    aria-disabled="true"
    class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-400 dark:border-slate-800 dark:text-slate-600"
    >← Previous</span
  >
  <% } %>

  <p class="text-sm text-slate-600 dark:text-slate-400">
    Page <%= pagination.page %> of <%= pagination.pageCount %>
  </p>

  <% if (pagination.nextHref) { %>
  <a
    href="<%= pagination.nextHref %>"
    rel="next"
    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-800 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
    >Next →</a
  >
  <% } else { %>
  <span
    aria-disabled="true"
    class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-400 dark:border-slate-800 dark:text-slate-600"
    >Next →</span
  >
  <% } %>
</nav>

<% } %>
