# ---------------------------------------------------------------------------
# MongoDB RAG KB MCP — example environment
#
# Copy to `.env` and fill in the secrets:   cp .env.example .env
# `.env` is gitignored and must never be committed.
#
# Every variable here is validated by zod at startup (src/config/env.ts).
# A missing or malformed value crashes the process immediately, by design.
# ---------------------------------------------------------------------------

# ---- runtime --------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Human-readable console logs via pino-pretty. Leave false in production.
LOG_PRETTY=true
SHUTDOWN_TIMEOUT_MS=10000

# Enable only when running behind a reverse proxy you control.
TRUST_PROXY=false

# ---- mongodb --------------------------------------------------------------
# Local dev / CI — Atlas Local (mongodb/mongodb-atlas-local). Vector Search and
# Atlas Search work exactly as they do in cloud Atlas.
#   from the host:              mongodb://localhost:27017/?directConnection=true
#   from the app container:     mongodb://mongodb:27017/?directConnection=true
# Production — cloud Atlas:     mongodb+srv://USER:PASS@cluster.mongodb.net/
MONGODB_URI=mongodb://mongodb:27017/?directConnection=true
MONGODB_DB_NAME=rag_kb
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Atlas Search / Vector Search index names. Definitions live in
# src/db/index-definitions/ and are applied with `npm run db:indexes`.
MONGODB_VECTOR_INDEX_NAME=chunks_vector_index
MONGODB_TEXT_INDEX_NAME=chunks_text_index
MONGODB_DOCUMENTS_TEXT_INDEX_NAME=documents_text_index
MONGODB_INDEX_READY_TIMEOUT_MS=300000

# ---- embeddings -----------------------------------------------------------
# voyage = real Voyage AI API.  fake = deterministic local vectors (tests/CI only).
EMBEDDING_PROVIDER=voyage

# voyage-context-3 is a CONTEXTUALISED model: each chunk is embedded together
# with its sibling chunks, which pairs with the structure-aware chunker.
EMBEDDING_MODEL=voyage-context-3

# MUST match numDimensions in the vector index definition.
# voyage-context-3 supports 2048 | 1024 | 512 | 256.
EMBEDDING_DIMENSIONS=1024

# Documents per upstream request (each document carries many chunks).
EMBEDDING_BATCH_SIZE=8

# Required when EMBEDDING_PROVIDER=voyage. Get one at https://dash.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_API_BASE_URL=https://api.voyageai.com/v1
VOYAGE_TIMEOUT_MS=30000
VOYAGE_MAX_RETRIES=3

# ---- chunking -------------------------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# Chunks below this size are merged into a neighbour instead of stored alone.
CHUNK_MIN_TOKENS=32

# ---- mcp server -----------------------------------------------------------
# Bearer token every MCP HTTP request must present. Minimum 16 characters.
# Generate one:  openssl rand -hex 32
MCP_AUTH_TOKEN=
MCP_PATH=/mcp
MCP_SERVER_NAME=mongodb-rag-kb
MCP_SERVER_VERSION=0.1.0

# Enable when browsers can reach this server, to block DNS-rebinding attacks.
MCP_DNS_REBINDING_PROTECTION=false

# Comma-separated. Only consulted when the protection above is enabled.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# ---- search ---------------------------------------------------------------
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50

# $vectorSearch numCandidates = limit * this multiplier.
SEARCH_CANDIDATE_MULTIPLIER=10

# Fuse vector + Atlas Search results with reciprocal rank fusion.
SEARCH_HYBRID_ENABLED=true
SEARCH_RRF_K=60

# Weight given to the vector ranking during fusion (text gets 1 - this).
SEARCH_VECTOR_WEIGHT=0.7

# ---- web ------------------------------------------------------------------
WEB_UI_ENABLED=true

# ---- open webui demo ------------------------------------------------------
# Compose-only: read by docker/docker-compose.demo.yml, never by src/config/env.ts.
OLLAMA_BASE_URL=http://ollama.example.com:11434
MCPO_API_KEY=change-me
