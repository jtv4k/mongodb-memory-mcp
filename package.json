{
  "name": "mongodb-memory-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that gives AI agents persistent, searchable memory backed by MongoDB — structure-aware chunking, contextual embeddings, and hybrid search over MCP, REST and a server-rendered web UI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtv4k/mongodb-memory-mcp.git"
  },
  "homepage": "https://github.com/jtv4k/mongodb-memory-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/public/css/app.css --watch",
    "build": "npm run build:ts && npm run build:css && npm run build:assets",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/public/css/app.css --minify",
    "build:assets": "node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "db:indexes": "tsx src/cli/setup-indexes.ts",
    "db:reembed": "tsx src/cli/reembed.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "mongodb": "^6.13.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/cli": "^4.0.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,mts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
